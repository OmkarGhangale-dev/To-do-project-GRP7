# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration (not used — project uses Firebase Firestore)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Firebase
FIREBASE_PROJECT_ID=taskflow-grp7
# Provide EITHER a service account JSON (base64-encoded) OR a local file path:
FIREBASE_SERVICE_ACCOUNT=<base64-encoded-service-account-json>
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json

# Groq AI — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the default Groq model
# GROQ_MODEL=llama-3.3-70b-versatile

# Authentication Secrets (for future JWT implementation)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
